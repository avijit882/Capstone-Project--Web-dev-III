NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/campuscart?replicaSet=rs0
JWT_ACCESS_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_REFRESH_SECRET=replace_with_another_random_secret_at_least_32_characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
CLIENT_ORIGIN=http://localhost:5173
BCRYPT_ROUNDS=12
ADMIN_NAME=CampusCart Administrator
ADMIN_EMAIL=admin@campuscart.local
ADMIN_PASSWORD=replace_with_a_private_password_of_12_or_more_characters

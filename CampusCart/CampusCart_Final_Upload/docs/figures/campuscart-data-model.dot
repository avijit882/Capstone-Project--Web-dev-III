digraph CampusCartDataModel {
  graph [rankdir=LR, bgcolor="#ffffff", pad="0.35", nodesep="0.5", ranksep="0.8", fontname="Arial", label="CAMPUSCART | MONGODB COLLECTION RELATIONSHIPS", labelloc=t, fontsize=20, fontcolor="#17365D"];
  node [shape=record, style="filled", fillcolor="#EAF2F8", color="#2F5597", fontname="Arial", fontsize=10, fontcolor="#18324A", margin="0.12"];
  edge [color="#51779E", penwidth=1.3, arrowsize=0.7, fontname="Arial", fontsize=9];
  users [label="{users|_id\lname\lemail (unique)\lpasswordHash\lrole / status\lsessionVersion\l}"];
  categories [label="{categories|_id\lname\lslug (unique)\lisActive\l}"];
  products [label="{products|_id\lname / SKU (unique)\lprice / stock\lcategory ref Category\lseller ref User\l}"];
  carts [label="{carts|_id\luser ref User (unique)\litems[] product ref + qty\l}"];
  orders [label="{orders|_id\lcheckoutGroupId\lcustomer ref User\lseller ref User\litems[] snapshots\lstatus / payment\l}"];
  tokens [label="{refreshTokens|_id\luser ref User\lfamilyId\lsessionVersion\ltokenHash (unique)\lexpiresAt / revokedAt / replacedBy\l}"];
  movements [label="{inventoryMovements|_id\lproduct ref Product\lseller / actor ref User\lquantityDelta\lpreviousStock / newStock\l}"];
  notifications [label="{notifications|_id\luser ref User\ltype / message\lisRead / readAt\l}"];
  users -> products [label="seller 1:N"];
  categories -> products [label="category 1:N"];
  users -> carts [label="customer 1:1"];
  products -> carts [label="cart items"];
  users -> orders [label="customer 1:N", color="#548235"];
  users -> orders [label="seller 1:N", color="#548235"];
  products -> orders [label="historical item reference"];
  users -> tokens [label="1:N"];
  users -> movements [label="actor / seller"];
  products -> movements [label="1:N"];
  users -> notifications [label="1:N"];
}
